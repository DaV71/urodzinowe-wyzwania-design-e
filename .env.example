# Skopiuj do .env i uzupełnij. Sekrety generuj np. przez: openssl rand -hex 32
# port lokalnej bazy z docker-compose.dev.yml (5432 bywa zajęty)
DEV_DB_PORT=55432
DATABASE_URL=postgresql://urodzinowe:urodzinowe@localhost:55432/urodzinowe
# min. 32 znaki
AUTH_SECRET=zmien-mnie-zmien-mnie-zmien-mnie-32
# min. 16 znaków
CODES_SECRET=zmien-mnie-kody-16
# min. 16 znaków — token w linku startowym jubilata
PLAYER_TOKEN=zmien-mnie-token-16
# min. 8 znaków
ADMIN_PASSWORD=zmien-mnie
APP_URL=http://localhost:3000
UPLOAD_DIR=./.data/uploads
